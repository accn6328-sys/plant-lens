# Gemini Vision API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Origin for CORS (Defaults to https://greenxonline.com)
ALLOWED_ORIGIN=https://greenxonline.com

# Shopify Product Catalog Endpoint
SHOPIFY_CATALOG_URL=https://greenxonline.com/products.json

# Optional Master Key for Force Refreshing Catalog Cache
FAWA_MASTER_KEY=fawa

# Port for local development
PORT=5000
